APP_NAME=Sumlink Analytics API
ENVIRONMENT=development
API_PREFIX=/api/v1
GA4_PROPERTY_ID=516899630
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/ga4-service-account.json

# Local development can disable authentication. Production requires API_KEYS.
AUTH_ENABLED=false
API_KEYS=
CORS_ORIGINS=*
CACHE_TTL_SECONDS=300

# Match these to your GA4 event names.
EVENT_INSTALL=first_open
EVENT_TUTORIAL_START=tutorial_step
EVENT_TUTORIAL_COMPLETE=tutorial_completed
EVENT_TUTORIAL_FAIL=tutorial_match_failed
EVENT_TUTORIAL_SKIP=tutorial_skipped
EVENT_LEVEL_START=level_start
EVENT_LEVEL_COMPLETE=level_complete
EVENT_HINT_USED=hint_used_successfully

# Register these event-scoped custom definitions in GA4 before using them.
LEVEL_DIMENSION=customEvent:level_number
TUTORIAL_STEP_DIMENSION=customEvent:step_number
LEVEL_TIME_METRIC=averageCustomEvent:time_taken
TUTORIAL_TIME_METRIC=averageCustomEvent:time_taken
