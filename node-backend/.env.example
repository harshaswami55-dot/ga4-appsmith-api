NODE_ENV=development
PORT=8000
GA4_PROPERTY_ID=516899630

# Base64-encoded service-account JSON. Never commit its value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local-only fallback; never commit the referenced file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/ga4-service-account.json

API_KEY=replace-with-a-long-random-value
ALLOWED_ORIGINS=http://localhost:3000,https://app.appsmith.com
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=100
