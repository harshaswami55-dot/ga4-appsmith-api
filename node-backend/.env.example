NODE_ENV=development
PORT=8000
GA4_PROPERTY_ID=516899630

# Paste raw JSON or a base64-encoded service-account JSON value on Render.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Local-only fallback; never commit the referenced file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/ga4-service-account.json

APPSMITH_ORIGIN=*
AUTH_ENABLED=false
API_KEYS=
CACHE_TTL_MS=300000

